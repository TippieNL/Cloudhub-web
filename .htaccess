DirectoryIndex index.php
RewriteEngine On

# Public share links, before the deny rules. A share URL ends in the shared
# file's extension, and the rules below refuse .log, .sql, .ts and friends --
# a shared notes.log or clip.ts would otherwise be a 403. /share/... never
# names a file under the project root, so those rules have nothing to protect.
RewriteRule ^share/[A-Za-z0-9_-]{20,128}(?:[./]|$) index.php [QSA,L]

# Never expose application internals, nor the Node/React source and build
# trees this PHP port sits beside.
RewriteRule ^(?:config|src|views|database|storage|logs|tests|tools|deploy|client|server|shared|script|node_modules|attached_assets)(?:/|$) - [F,L,NC]
RewriteRule ^\.env(?:\..*)?$ - [F,L,NC]
RewriteRule ^(?:composer\.(?:json|lock)|phpunit\.xml|README\.md|SECURITY\.md|PROJECT_CONTEXT\.md|replit\.md|package(?:-lock)?\.json|drizzle\.config\.ts|components\.json|skills-lock\.json|tsconfig\.json|vite\.config\.ts|tailwind\.config\.ts|postcss\.config\.js)$ - [F,L,NC]
RewriteRule .*\.(?:bak|old|orig|save|sql|log|ini|dist|ts|tsx)$ - [F,L,NC]
# Any dot-segment: /.git/config, /.gitignore, /.agents, editor droppings.
# /.well-known/ stays reachable: ACME HTTP-01 certificate renewal answers from it.
RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [F,L]

# Public static files.
RewriteRule ^favicon\.png$ public/favicon.png [L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# Existing public files may be requested through /public/ directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^public/ - [L]

# Compress text assets. app.js alone is 74 KB before compression, and the
# stylesheets and player modules add to that on a first visit. Wrapped in
# IfModule so the file stays valid where the module is not built in -- KSWEB's
# Apache is not guaranteed to carry either of these.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# Static assets are versionless, so they are revalidated rather than held
# indefinitely: a week with must-revalidate keeps a deploy from serving stale
# JavaScript to a browser that already has it. The thumbnail route sets its own
# immutable, year-long policy in PHP, because those URLs do change per file.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header append Cache-Control "must-revalidate"
  </FilesMatch>
</IfModule>

# Everything else goes through the root bootstrap. This intentionally also
# handles the existing project directory itself when installed in a subfolder.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
