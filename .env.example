APP_ENV=production
APP_URL=http://localhost:8000
ROOT_DIR=storage/files
READ_ONLY=false
ALLOW_DELETE=true
ALLOW_OVERWRITE=true
# Deleted items move to a trash inside the storage root and are purged after
# TRASH_RETENTION_DAYS. Set TRASH_ENABLED=false to delete permanently instead;
# set the retention to 0 to keep trashed items until someone empties the trash.
TRASH_ENABLED=true
TRASH_RETENTION_DAYS=30
# Storage limits. 0 means unlimited. STORAGE_LIMIT_GB caps the whole file
# store; USER_QUOTA_GB caps what one account may have uploaded. Both are
# checked before an upload starts. Measuring the store walks it, so the
# result is cached for USAGE_CACHE_SECONDS.
STORAGE_LIMIT_GB=0
USER_QUOTA_GB=0
USAGE_CACHE_SECONDS=300
HTTPS_ENABLED=false
REQUIRE_HTTPS=false
TRUST_PROXY=false
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
SESSION_IDLE_SECONDS=3600
SESSION_ABSOLUTE_SECONDS=43200
SESSION_ROTATE_SECONDS=900
SESSION_SAMESITE=Lax
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_USER_ATTEMPTS=5
LOGIN_RATE_IP_ATTEMPTS=20
LOGIN_RATE_RETENTION_SECONDS=86400
# Generate a long random value for production, e.g. 32+ random bytes encoded as hex.
RATE_LIMIT_SECRET=change-to-a-long-random-secret
SECURITY_EVENT_RETENTION_DAYS=90
SHARE_EXPIRY_HOURS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloud_file_hub
DB_USER=cloudhub
DB_PASS=change-me
DB_CHARSET=utf8mb4
MAX_UPLOAD_MB=2048
MAX_UPLOAD_FILES=20
UPLOAD_CHUNK_MB=8
UPLOAD_RETRY_COUNT=3
UPLOAD_ABANDON_HOURS=24
UPLOAD_CONFLICT=rename
UPLOAD_STAGING_DIR=
